# Login role that is a member of app_user, app_auth and app_jobs. Never a superuser or the table owner.
DATABASE_URL=postgres://poker_web:CHANGE_ME@localhost:5432/poker_dev
# 32 random bytes, base64 (openssl rand -base64 32). In production: from the secret manager / KMS.
FIELD_KEY=
# Salt for hashing client IPs in sessions and logs.
IP_HASH_SALT=
# Public origin (https in production): invite links, QR codes, Telegram buttons.
APP_URL=http://localhost:3000

# Telegram (optional; the site works without it).
# From @BotFather: the token and the bot's username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string (16+ chars); Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional Mini App short name registered with /newapp (t.me/<bot>/<name>).
TELEGRAM_APP_NAME=

# Bearer secret (16+ chars) for the scheduler (POST /api/cron/tick every 10 minutes)
# and the one-time Telegram setup (POST /api/telegram/setup).
CRON_SECRET=

# Email (optional): verification links, password reset, game-night reminders.
# Any SMTP provider, e.g. smtps://user:pass@smtp.example.com:465. Without it, development
# prints messages to the server log and production sends nothing.
SMTP_URL=
MAIL_FROM="Poker Home <no-reply@example.com>"

# Sign in with Google (optional). OAuth client of type "Web application"; redirect URI:
# <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional). Services ID, team, key id and the .p8 key (newlines as \n).
# Return URL: <APP_URL>/api/auth/apple/callback (Apple requires https).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Site admins for support (comma-separated). They need a confirmed email and two-step
# verification; the panel is at /admin and every step is logged.
ADMIN_EMAILS=

# Server-side PDF export (optional): path to a Chromium binary on the server. Without it,
# people use the print view (browser Print to PDF).
PDF_CHROMIUM_PATH=
