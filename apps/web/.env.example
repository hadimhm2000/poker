# Login role that is a member of app_user, app_auth, app_jobs and app_billing. Never a superuser or the table owner.
DATABASE_URL=postgres://poker_web:CHANGE_ME@localhost:5432/poker_dev
# 32 random bytes, base64 (openssl rand -base64 32). In production: from the secret manager / KMS.
FIELD_KEY=
# Salt for hashing client IPs in sessions and logs.
IP_HASH_SALT=
# Public origin (https in production): invite links, QR codes, Telegram buttons.
APP_URL=http://localhost:3000

# Telegram (optional; the site works without it).
# From @BotFather: the token and the bot's username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string (16+ chars); Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional Mini App short name registered with /newapp (t.me/<bot>/<name>).
TELEGRAM_APP_NAME=

# Bearer secret (16+ chars) for the scheduler (POST /api/cron/tick every 10 minutes)
# and the one-time Telegram setup (POST /api/telegram/setup). The tick also ends Pro for
# subscriptions whose paid period ran out.
CRON_SECRET=

# Payments with Paddle Billing (optional; without them the pricing page shows the plans and
# says online payment is not available yet). See README "Payments".
# sandbox (test cards, sandbox-*.paddle.com) or production.
PADDLE_ENV=sandbox
# Client-side token (Developer tools > Authentication), starts with test_ (sandbox) or live_.
PADDLE_CLIENT_TOKEN=
# Price ids (pri_...) of the Pro product, monthly and yearly. A free trial is set on the price in Paddle.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# Secret key of the notification destination for POST /api/billing/webhook (pdl_ntfset_...).
PADDLE_WEBHOOK_SECRET=
# Server API key allowed to create customer portal sessions (the Cancel and Invoices buttons).
# Leave empty to hide those buttons.
PADDLE_API_KEY=
# Shown on the pricing page only; what is charged is the Paddle price. Integers in the smallest
# unit (399 = 3.99). Defaults: 399, 2900, USD.
PRICING_MONTHLY_CENTS=399
PRICING_YEARLY_CENTS=2900
PRICING_CURRENCY=USD
# Days of free trial configured on the Paddle prices, only to mention it on the pricing page (empty = none).
PRO_TRIAL_DAYS=
