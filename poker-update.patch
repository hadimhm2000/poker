+const devOrigins = ["127.0.0.1", "[::1]", ...(process.env.DEV_ORIGINS ?? "").split(",").map((h) => h.trim()).filter(Boolean)];
+
 const nextConfig: NextConfig = {
+  allowedDevOrigins: devOrigins,
   poweredByHeader: false,
